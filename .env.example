# URL reachable from the Gutter container; do not use localhost for another container.
KOMGA_URL=http://komga:25600
# Create an API key in Komga. Do not commit your real key.
KOMGA_API_KEY=

# Required for M2 onward.
METRON_USER=
METRON_PASSWORD=
# Required for M4 onward.
COMICVINE_API_KEY=
KAPOWARR_URL=http://kapowarr:5656
KAPOWARR_API_KEY=
# Required for M3 onward.
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
# Optional when the ntfy topic is protected.
NTFY_TOKEN=

# Must be reachable from your phone for notification click-through links.
APP_BASE_URL=http://192.168.1.10:3000
WEEKLY_DIGEST_CRON="0 9 * * 3"
RELEASE_CHECK_CRON="0 */6 * * *"
TZ=Europe/Amsterdam
RECOMMENDATION_SEED_COUNT=5
RECOMMENDATION_EXCLUSION_DAYS=14

# Nightly SQLite backup in TZ; keep the newest seven daily copies.
BACKUP_CRON="30 3 * * *"
# Optional. Default: backups/ beside the DB (/data/backups in Docker).
# BACKUP_DIR=/backups
